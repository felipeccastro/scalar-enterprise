# Copy this file to .env and fill in the values you need. .env is gitignored.

# --- App ---
# APP_NAME=Your App
# SECRET_KEY=change-me-in-production

# --- Database ---
# Postgres only. Defaults to a local instance on the standard port, database
# "scalar" — create it once with `createdb scalar` (or `psql -c 'CREATE
# DATABASE scalar'`) before the first `make db-migrate` / `python3 app.py`.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=scalar
# PGUSER=
# PGPASSWORD=

# --- Storage ---
# Attachments are stored on local disk. Optional: override where they live
# (defaults to ./uploads next to this file).
# UPLOAD_FOLDER=/path/to/uploads

# --- AI chat backend (Ask AI) ---
# Two interchangeable backends, both running the same read-only tool-calling
# agent loop (see ai.py):
#   - OpenAI-compatible cloud: set OPENAI_API_KEY.
#   - Local Ollama: leave OPENAI_API_KEY unset (the default).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma4

# --- Email (Resend), used for invite + password-reset emails ---
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=no-reply@example.com

# --- Dev server ---
# HOST=0.0.0.0
# PORT=8000
# DEBUG=1
